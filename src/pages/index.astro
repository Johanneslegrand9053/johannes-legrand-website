---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import Experience from "../components/Experience.astro";
import Contact from "../components/Contact.astro";
import { t } from "../i18n";
import {
  getSiteSettings, getHero, getAbout, getServices,
  getExperience,
} from "../lib/sanity";

const lang = "de";
const tr = t(lang);

const [settings, sanityHero, sanityAbout, sanityServices, sanityExperience] =
  await Promise.all([
    getSiteSettings(), getHero(), getAbout(), getServices(),
    getExperience(),
  ]);

// ── Hero ──────────────────────────────────────────────────────────────────
if (sanityHero) {
  tr.hero.available    = sanityHero.available    ?? tr.hero.available;
  // subtitle from i18n
  tr.hero.tagline      = sanityHero.tagline      ?? tr.hero.tagline;
  tr.hero.description  = sanityHero.description  ?? tr.hero.description;
  if (sanityHero.stats?.length) {
    tr.hero.stats = sanityHero.stats.map((s: any) => ({
      value: s.value, suffix: s.suffix, label: s.label ?? s.label_en,
    }));
  }
}

// ── About ─────────────────────────────────────────────────────────────────
if (sanityAbout) {
  tr.about.label  = sanityAbout.label  ?? tr.about.label;
  // title from i18n
  tr.about.bio    = sanityAbout.bio    ?? tr.about.bio;
  tr.about.bio2   = sanityAbout.bio2   ?? tr.about.bio2;
  if (sanityAbout.highlights?.length) {
    tr.about.highlights = sanityAbout.highlights.map((h: any) => h.text ?? h.text_en);
  }
}

// ── Services ──────────────────────────────────────────────────────────────
if (sanityServices?.length) {
  tr.services.items = sanityServices.map((s: any) => ({
    title: s.title, description: s.description,
  }));
}

// ── Experience ────────────────────────────────────────────────────────────
if (sanityExperience?.length) {
  tr.experience.items = sanityExperience
    .filter((e: any) => e.company !== "Henry Lamotte")
    .map((e: any) => ({
      company: e.company, location: e.location,
      roles: (e.roles ?? []).map((r: any) => ({
        period: r.period,
        role: e.company.trim() === "JJL Interim Management" ? "Interim COO / CSCO / Advisory" : r.role,
        description: r.description,
      })),
    }));
}
---

<Layout
  lang={lang}
  tr={tr}
  settings={settings}
  title="Johannes Legrand – Interim COO & Geschäftsführer"
  description="Erfahrener Interim COO und Geschäftsführer. Transformation, Wachstum, Restrukturierung. Verfügbar für Mandate in der DACH-Region."
>
  <Hero tr={tr} lang={lang} profileImage={sanityHero?.profileImage} />
  <About tr={tr} aboutImage={sanityAbout?.image} badgeValue={sanityAbout?.badgeValue} badgeLabel={sanityAbout?.badgeLabel} />
  <Services tr={tr} />
  <Experience tr={tr} />
  <Contact tr={tr} settings={settings} />
</Layout>
