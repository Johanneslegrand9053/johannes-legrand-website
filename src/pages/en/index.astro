---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import About from "../../components/About.astro";
import Services from "../../components/Services.astro";
import Experience from "../../components/Experience.astro";
import Contact from "../../components/Contact.astro";
import { t } from "../../i18n";
import {
  getSiteSettings, getHero, getAbout, getServices,
  getExperience,
} from "../../lib/sanity";

const lang = "en";
const tr = t(lang);

const [settings, sanityHero, sanityAbout, sanityServices, sanityExperience] =
  await Promise.all([
    getSiteSettings(), getHero(), getAbout(), getServices(),
    getExperience(),
  ]);

// ── Hero ──────────────────────────────────────────────────────────────────
if (sanityHero) {
  tr.hero.available   = sanityHero.available_en   ?? sanityHero.available   ?? tr.hero.available;
  // subtitle from i18n
  tr.hero.tagline     = sanityHero.tagline_en     ?? sanityHero.tagline     ?? tr.hero.tagline;
  tr.hero.description = sanityHero.description_en ?? sanityHero.description ?? tr.hero.description;
  if (sanityHero.stats?.length) {
    tr.hero.stats = sanityHero.stats.map((s: any) => ({
      value: s.value, suffix: s.suffix, label: s.label_en ?? s.label,
    }));
  }
}

// ── About ─────────────────────────────────────────────────────────────────
if (sanityAbout) {
  tr.about.label  = sanityAbout.label_en  ?? sanityAbout.label  ?? tr.about.label;
  // title from i18n
  tr.about.bio    = sanityAbout.bio_en    ?? sanityAbout.bio    ?? tr.about.bio;
  tr.about.bio2   = sanityAbout.bio2_en   ?? sanityAbout.bio2   ?? tr.about.bio2;
  if (sanityAbout.highlights?.length) {
    tr.about.highlights = sanityAbout.highlights.map((h: any) => h.text_en ?? h.text);
  }
}

// ── Services ──────────────────────────────────────────────────────────────
if (sanityServices?.length) {
  tr.services.items = sanityServices.map((s: any) => ({
    title: s.title_en ?? s.title, description: s.description_en ?? s.description,
  }));
}

// ── Experience ────────────────────────────────────────────────────────────
if (sanityExperience?.length) {
  tr.experience.items = sanityExperience
    .filter((e: any) => e.company !== "Henry Lamotte")
    .map((e: any) => ({
      company: e.company, location: e.location,
      roles: (e.roles ?? []).map((r: any) => ({
        period: r.period,
        role: e.company.trim() === "JJL Interim Management" ? "Interim COO / CSCO / Advisory" : (r.role_en ?? r.role),
        description: r.description_en ?? r.description,
      })),
    }));
}
---

<Layout
  lang={lang}
  tr={tr}
  settings={settings}
  title="Johannes Legrand – Interim COO & Managing Director"
  description="Experienced Interim COO and Managing Director. Transformation, growth, restructuring. Available for mandates in the DACH region."
>
  <Hero tr={tr} lang={lang} profileImage={sanityHero?.profileImage} />
  <About tr={tr} aboutImage={sanityAbout?.image} badgeValue={sanityAbout?.badgeValue} badgeLabel={sanityAbout?.badgeLabel_en ?? sanityAbout?.badgeLabel} />
  <Services tr={tr} />
  <Experience tr={tr} />
  <Contact tr={tr} settings={settings} />
</Layout>
