---
interface Props {
  tr: any;
}
const { tr } = Astro.props;
---

<section id="experience" class="reveal">
  <div class="container">
    <div class="exp-header">
      <div>
        <span class="section-label reveal-heading">{tr.experience.label}</span>
        <h2 class="reveal-heading">{tr.experience.title}</h2>
        <div class="divider reveal-heading"></div>
      </div>
    </div>

    <div class="timeline">
      {tr.experience.items.map((item: any, i: number) => (
        <div class="timeline-item">
          <div class="timeline-marker">
            <div class="marker-dot"></div>
            {i < tr.experience.items.length - 1 && <div class="marker-line"></div>}
          </div>

          <div class="card company-card reveal-item">
            <div class="company-header">
              <h3 class="company-name">{item.company}</h3>
              <span class="company-location">{item.location}</span>
            </div>

            <div class="roles">
              {item.roles.map((role: any, j: number) => (
                <div class={`role-item ${j < item.roles.length - 1 ? "role-item--separator" : ""}`}>
                  <span class="role-period">{role.period}</span>
                  <p class="role-title">{role.role}</p>
                  <p class="role-desc">{role.description}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.exp-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 56px;
  flex-wrap: wrap;
}

.section-sub {
  font-size: 1.0625rem;
  color: var(--color-text-light);
  margin-top: 8px;
  max-width: 480px;
}

.timeline {
  display: flex;
  flex-direction: column;
  max-width: 820px;
}

.timeline-item {
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: 24px;
  margin-bottom: 24px;
}

.timeline-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 28px;
}

.marker-dot {
  width: 14px;
  height: 14px;
  background: var(--color-accent);
  border-radius: 50%;
  border: 3px solid var(--color-bg);
  box-shadow: 0 0 0 2px var(--color-accent);
  flex-shrink: 0;
  z-index: 1;
}

.marker-line {
  width: 2px;
  flex: 1;
  background: var(--color-border);
  margin-top: 8px;
  min-height: 40px;
}

.company-card {
  padding: 0;
  overflow: hidden;
  transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
}

.company-card:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-3px);
  border-color: var(--color-accent);
}

.company-card:hover .company-header {
  background: #0F172A;
}

.company-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 20px 28px;
  background: var(--color-primary);
  flex-wrap: wrap;
}

.company-name {
  font-size: 1.125rem;
  font-weight: 700;
  color: #FFFFFF;
  margin: 0;
}

.company-location {
  font-size: 0.8125rem;
  font-weight: 500;
  color: rgba(255,255,255,0.5);
  letter-spacing: 0.03em;
}

.roles {
  display: flex;
  flex-direction: column;
}

.role-item {
  padding: 22px 28px;
}

.role-item--separator {
  border-bottom: 1px solid var(--color-border);
}

.role-period {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 6px;
}

.role-title {
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 8px;
  line-height: 1.3;
}

.role-desc {
  font-size: 0.9rem;
  color: var(--color-text);
  line-height: 1.7;
}

@media (max-width: 640px) {
  .exp-header { flex-direction: column; }
  .timeline-item { grid-template-columns: 28px 1fr; gap: 16px; }
  .company-header, .role-item { padding: 16px 20px; }
}
</style>
