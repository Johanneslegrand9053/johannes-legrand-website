---
interface Props {
  from: string;
  to: string;
  flip?: boolean;
}
const { from, to, flip = false } = Astro.props;
---

<div class={`curve-divider ${flip ? "flip" : ""}`} style={`background:${from};`}>
  <svg viewBox="0 0 1440 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d={flip
        ? "M0,90 C360,0 1080,0 1440,90 L1440,90 L0,90 Z"
        : "M0,0 C360,90 1080,90 1440,0 L1440,90 L0,90 Z"}
      fill={to}
    />
  </svg>
</div>

<style>
.curve-divider {
  line-height: 0;
  margin-bottom: -2px;
}
.curve-divider svg {
  display: block;
  width: 100%;
  height: 90px;
}
</style>
